{
  "autoDocstring.docstringFormat": "sphinx",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'JetBrains Mono'",
  "editor.fontSize": 13,
  "C_Cpp.default.includePath": ["/opt/ros/melodic/include"],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "window.titleBarStyle": "custom",
  "vim.cursorStylePerMode.insert": "underline",
  "vim.cursorStylePerMode.normal": "block-outline",
  "window.menuBarVisibility": "toggle",
  "editor.tabSize": 2,
  "editor.autoClosingBrackets": "beforeWhitespace",
  "editor.autoClosingQuotes": "never",
  "vim.foldfix": true,
  "editor.minimap.enabled": false,
  "editor.rulers": [80, 120],
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#aaaaaa27"
  },
  "zenMode.hideLineNumbers": false,
  "editor.wordWrap": "off",
  "editor.wordWrapColumn": 80,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "zenMode.hideStatusBar": false,
  "zenMode.centerLayout": false,
  "clock.alignment": "Right",
  "clock.format": "dd/mm/yyyy HH:MM",
  "vim.useSystemClipboard": true,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "latex-workshop.view.pdf.viewer": "external",
  "clang-format.language.java.enable": false,
  "clang-format.language.javascript.enable": false,
  "clang-format.language.objective-c.enable": false,
  "clang-format.language.objective-cpp.enable": false,
  "clang-format.language.typescript.enable": false,
  "editor.unicodeHighlight.allowedLocales": {
    "tr": true
  },
  "vim.leader": "<space>",
  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "w", "j"],
      "commands": ["workbench.action.splitEditorOrthogonal"]
    },
    {
      "before": ["<leader>", "w", "h"],
      "commands": ["workbench.action.splitEditorLeft"]
    },
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.navigateDown"]
    },
    {
      "before": ["<C-k>"],
      "commands": ["workbench.action.navigateUp"]
    },
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.navigateLeft"]
    },
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.navigateRight"]
    },
    {
      "before": ["g", "f"],
      "commands": ["editor.action.revealDefinition"]
    },
    {
      "before": ["g", "b"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["<leader>", "f", "e"],
      "commands": ["workbench.action.focusSideBar"]
    },
    {
      "before": ["<leader>", "f", "c"],
      "commands": ["workbench.action.toggleZenMode"]
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.referenceSearch.trigger"]
    },
    {
      "before": ["<leader>", "d", "o"],
      "commands": ["workbench.action.debug.stepOver"]
    },
    {
      "before": ["<leader>", "d", "i"],
      "commands": ["workbench.action.debug.stepInto"]
    },
    {
      "before": ["<leader>", "d", "b"],
      "commands": ["editor.debug.action.toggleBreakpoint"]
    },
    {
      "before": ["<leader>", "d", "c"],
      "commands": ["workbench.action.debug.continue"]
    },
    {
      "before": ["<leader>", "f", "t"],
      "commands": [
        {
          "command": "workbench.action.terminal.focus"
        },
        {
          "command": "command-runner.run",
          "args": {
            "command": "rgf"
          }
        }
      ]
    }
  ],
  "terminal.integrated.fontSize": 14,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "workbench.activityBar.orientation": "vertical",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "command-runner.commands": {
    "rgf": "rgf; exit"
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "go.lintTool": "golangci-lint",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "workbench.colorTheme": "Jetbrains Dark Theme",
  "debug.allowBreakpointsEverywhere": true,
  "debug.javascript.autoAttachFilter": "disabled"
}
